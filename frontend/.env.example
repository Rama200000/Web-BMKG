# Konfigurasi Environment Frontend (Vite)

# URL Backend API (Default: http://localhost:8000/api)
VITE_API_BASE_URL=http://localhost:8000/api

# URL Publik Aplikasi (Opsional)
# Kosongkan untuk deteksi otomatis IP LAN WiFi / localhost di dev server.
# Isi jika dideploy ke domain publik (contoh: https://siiklimmuda.bmkg.go.id)
# VITE_PUBLIC_URL=
